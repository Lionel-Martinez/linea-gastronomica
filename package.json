{
  "name": "linea-gastronomica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build --mode completo",
    "preview": "vite preview",
    "build:carta": "vue-tsc -b && vite build --mode carta",
    "build:panel": "vue-tsc -b && vite build --mode panel",
    "build:mesa": "vue-tsc -b && vite build --mode mesa",
    "build:delivery": "vue-tsc -b && vite build --mode delivery",
    "build:completo": "vue-tsc -b && vite build --mode completo",
    "build:all": "vue-tsc -b && vite build --mode carta --outDir dist-carta && vite build --mode panel --outDir dist-panel && vite build --mode mesa --outDir dist-mesa && vite build --mode delivery --outDir dist-delivery && vite build --mode completo --outDir dist-completo",
    "dev:carta": "vite --mode carta",
    "dev:panel": "vite --mode panel",
    "dev:mesa": "vite --mode mesa",
    "dev:delivery": "vite --mode delivery",
    "dev:completo": "vite --mode completo"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@lucide/vue": "^1.67.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.4",
    "axios": "^1.21.0",
    "leaflet": "^1.9.4",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
